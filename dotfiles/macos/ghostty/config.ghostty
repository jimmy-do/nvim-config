# --- Window & UX ---
# Adds breathing room so logs don't smash against the glass
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true



background-opacity-cells = true

# macOS specific: Integrates tabs natively into the titlebar to #save vertical space
macos-option-as-alt = left

# --- Behavior & Performance ---
mouse-hide-while-typing = true
copy-on-select = clipboard

shell-integration = zsh

