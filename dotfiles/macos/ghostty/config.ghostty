background-opacity = .95
background-blur = 0
background-opacity-cells = false
#jetbrainsmono presets
font-style = light
font-size = 16
font-thicken = true
font-thicken-strength = 0
adjust-cell-height = -4%
adjust-cell-width = 2%

#oled
#theme = akari-night
#macbook
#theme = "Gruvbox Dark"
#theme = Tomorrow Night Eighties
#theme = Gruvbox Material Dark
# theme = Material
# theme = Material Dark
# theme = Material Darker
# theme = Material Design Colors
# theme = Material Ocean
# theme = JetBrains Darcula
# theme = Nightfox
# theme = Nordfox
# theme = TokyoNight
# theme = TokyoNight Day
# theme = TokyoNight Moon
# theme = TokyoNight Night
# theme = TokyoNight Storm
# theme = Tomorrow

# theme = Tomorrow Night Blue
# theme = Tomorrow Night Bright
# theme = Tomorrow Night Burns
# Custom Base16 Gruvbox Material Dark-ish
# theme = Spacegray Eighties
# theme = Spacegray Eighties Dull

background = 282828
foreground = d4be98
selection-background = 3c3836
selection-foreground = d4be98

palette = 0=282828
palette = 1=ea6962
palette = 2=a9b665
palette = 3=d8a657
palette = 4=7daea3
palette = 5=d3869b
palette = 6=89b482
palette = 7=d4be98
palette = 8=928374
palette = 9=ea6962
palette = 10=a9b665
palette = 11=d8a657
palette = 12=7daea3
palette = 13=d3869b
palette = 14=89b482
palette = 15=ddc7a1

keybind = all:super+equal=increase_font_size:0.5
keybind = all:super+minus=decrease_font_size:0.5
keybind = all:super+zero=reset_font_size

# tmux window navigation
keybind = cmd+shift+h=csi:5;30012~
keybind = cmd+j=csi:5;30012~
keybind = cmd+k=csi:5;30013~
keybind = cmd+l=csi:5;30013~
keybind = cmd+semicolon=csi:5;30014~

# alt fallback
keybind = alt+h=esc:h
keybind = alt+l=esc:l

# Keep Cmd+Left / Cmd+Right for shell line navigation.
# Do NOT send Ctrl-a because tmux uses C-a as prefix.
keybind = cmd+left=csi:H
keybind = cmd+right=csi:F

macos-option-as-alt = left

# Use a Nerd Font. Critical for displaying Git branch icons, Kubernetes
# wheel icons, and Terraform states in your prompt.

#font-family =  terminess nerd font
#font-family = DejaVuSansM Nerd Font Mono
#font-family = MesloLGSDZ Nerd Font Mono
font-family = jetbrainsmono nerd font
#font-family = droidsansm Nerd Font
#font-family = hack nerd font
#font-family = CaskaydiaCove Nerd Font Mono
#font-family = Iosevka Nerd Font Mono

#dejavusansm
#font-style = regular
#font-size = 20
#adjust-cell-width = -8%
#adjust-cell-height = 10%
#font-thicken = true
#font-thicken-strength = 0


#preset for terminess
#font-style = bold
#font-size = 20
#font-thicken = true
#font-thicken-strength = 0
#adjust-cell-width = -6%
#adjust-cell-height = 20%

cursor-style = block
cursor-style-blink = true
cursor-color = d4be98
shell-integration-features = no-cursor

window-decoration = auto
macos-titlebar-style = tabs

