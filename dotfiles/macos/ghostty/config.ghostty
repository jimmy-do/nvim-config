# --- Window & UX ---
# Adds breathing room so logs don't smash against the glass
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# --- Behavior & Performance ---
mouse-hide-while-typing = true
copy-on-select = clipboard

shell-integration = zsh

