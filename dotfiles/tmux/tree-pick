#!/usr/bin/env zsh
# prefix w -- fzf replacement for tmux's built-in choose-tree.
#
# WHY NOT choose-tree: its keys are hardcoded in mode-tree.c and there is no
# `choose-tree` key table (`tmux list-keys -T choose-tree` errors), so a bare `?`
# for help could never be bound inside it -- help meant a SECOND prefix key, and
# moving a pane meant leaving the tree entirely to type join-pane. Both of those
# are single keys in here. tmux's original tree is kept on prefix C-w.
#
# Pieces:  tree-list     rows (one per pane, tab-separated id + display)
#          tree-preview  right-hand side: live pane content, or the help
#          tree-help.md  the help text, bat-highlighted by tree-preview
#
# Every action targets field 1 of the highlighted row, a %N pane id, which is
# stable across renames and reindexing -- unlike session:window.pane strings.

here=${0:A:h}

# Flag file for the ? toggle. Non-empty = show help. Removed on exit.
export TREE_STATE=$(mktemp -t tmux-tree)
trap 'rm -f $TREE_STATE' EXIT

bright=$(tmux show -gv @ui-bright); bright=${bright:-#ff6a00}
dim=$(tmux show -gv @ui-dim);       dim=${dim:-#7a3200}
sunk=$(tmux show -gv @ui-sunk);     sunk=${sunk:-#331500}

# Header keeps the four keys that answer "how do I move a pane", which was the
# whole reason the old tree failed. Everything else lives behind ?.
hdr=$'\033[38;2;'"$((16#${dim[2,3]}));$((16#${dim[4,5]}));$((16#${dim[6,7]}))m"
hbr=$'\033[38;2;'"$((16#${bright[2,3]}));$((16#${bright[4,5]}));$((16#${bright[6,7]}))m"
R=$'\033[0m'
header="${hbr}M-m${hdr} mark  ${hbr}C-j${hdr} join below  ${hbr}C-l${hdr} join beside  ${hbr}C-s${hdr} swap  ${hbr}?${hdr} help${R}"

# --bind notes:
#   ?           flip the flag file, redraw the preview. No second prefix, no
#               second popup, no leaving the list.
#   execute-silent+reload   actions that change tmux state redraw the rows so
#               the MARK badge and pane list are never stale.
#   become()    hands the process over on accept, so switch-client runs after
#               fzf has torn down and the popup is already closing.
sel=$(
  "$here/tree-list" | fzf --ansi --no-sort --delimiter=$'\t' --with-nth=2.. \
    --layout=reverse --info=inline --border=rounded \
    --border-label=" PANES " --border-label-pos=3 \
    --prompt="  " --pointer="▸" --gutter=" " \
    --header="$header" --header-first \
    --preview="$here/tree-preview {1}" \
    --preview-window="right,55%,border-left,nowrap" \
    --color="bg+:$sunk,fg+:$bright,pointer:#FF2E97,prompt:$bright,border:$dim,label:$bright,header:$dim" \
    --bind="?:execute-silent(if [ -s \$TREE_STATE ]; then : > \$TREE_STATE; else echo 1 > \$TREE_STATE; fi)+refresh-preview" \
    --bind="pgup:preview-page-up,pgdn:preview-page-down" \
    --bind="alt-m:execute-silent(tmux select-pane -m -t {1})+reload($here/tree-list)" \
    --bind="alt-M:execute-silent(tmux select-pane -M)+reload($here/tree-list)" \
    --bind="ctrl-j:execute-silent($here/tree-act join-v {1})+reload($here/tree-list)" \
    --bind="ctrl-l:execute-silent($here/tree-act join-h {1})+reload($here/tree-list)" \
    --bind="ctrl-s:execute-silent($here/tree-act swap {1})+reload($here/tree-list)" \
    --bind="ctrl-b:execute-silent($here/tree-act break {1})+reload($here/tree-list)" \
    --bind="ctrl-x:execute-silent($here/tree-act kill {1})+reload($here/tree-list)" \
    --bind="ctrl-r:execute($here/tree-act rename {1})+reload($here/tree-list)" \
    --bind="ctrl-o:reload($here/tree-list)" \
  | cut -f1
)

[[ -z $sel ]] && exit 0

# Three commands, not one: switch-client only moves the session, select-window
# only the window. A pane row implies all three levels, so all three are set.
tmux switch-client -t "$sel"
tmux select-window -t "$sel"
tmux select-pane   -t "$sel"
