#!/bin/bash
# copy-ring — stamp PER-SEGMENT ring flags on every pane so the ring around
# the active pane (bright) and around copy-mode panes (lime) lights exactly
# the lines that TOUCH the pane, per Jimmy's rule.
#
# WHY PER-SEGMENT, not one flag per pane (the bug this replaces): a pane owns
# TWO kinds of border cells -- its TITLE ROW (the horizontal line above it;
# with pane-border-status top a horizontal separator belongs to the pane
# BELOW it) and its RIGHT DIVIDER (a vertical divider belongs to the pane to
# its LEFT). Those two segments touch different neighbours, and a single
# per-pane flag lit both together -- a pane whose divider touched the active
# pane also lit its unrelated title row, so "all the lines light up".
#
#   @active_row / @copy_row  -> the pane's TITLE ROW touches the state:
#                               the pane itself is in the state, or the
#                               state pane is immediately ABOVE it
#   @active_col / @copy_col  -> the pane's RIGHT DIVIDER touches the state:
#                               the pane itself is in the state, or the
#                               state pane is immediately to its RIGHT
#
# The row flags are consumed by pane-border-format (which draws the title row
# and now paints its own line fill); the col flags by the two border styles,
# which after the format fill only ever colour vertical dividers.
#
# Adjacency gaps are 2 at rest, 3 while the modal scrollbar is showing
# (copy mode shrinks the pane by one column, probe-verified).
#
# Fired by hooks (tmux.conf): pane-mode-changed, window-layout-changed,
# window-pane-changed, and once at config load. Recomputes everything every
# run, so flags clear themselves. NB: no apostrophes in awk comments -- one
# once terminated the quoted program.
tmux list-panes -a -F '#{window_id} #{pane_id} #{pane_in_mode} #{pane_active} #{pane_left} #{pane_top} #{pane_right} #{pane_bottom}' |
awk '
{ win[NR]=$1; id[NR]=$2; mode[NR]=$3; act[NR]=$4; L[NR]=$5; T[NR]=$6; R[NR]=$7; B[NR]=$8; n=NR
  if (R[NR] > maxR[$1]) maxR[$1] = R[NR] }
END {
  # COL flags (@active_col bright ring, @copy_col lime ring) share ONE rule so
  # both rings light a shared divider along its WHOLE length. tmux native
  # pane-border-indicators only lights the HALF of a shared divider nearest the
  # active pane (probe-verified, tmux.conf ~L519), leaving the far half dim --
  # the "only lights up halfway" bug, on the active ring AND the copy ring.
  #
  # The col flag lights the whole divider, but ONLY when it genuinely abuts the
  # state pane, so it never over-lights past panes the state pane never touches
  # (the granularity trap that killed the old per-pane flag). For state S (S =
  # active for acol, S = in-copy-mode for ccol), the flag on pane i is set when:
  #   1. i itself is in state S (its own right divider is all its own), OR
  #   2. an S pane sits immediately RIGHT of i and fully spans it (whole divider
  #      shared), OR
  #   3. an S pane sits immediately LEFT of i, fully spans it, AND i is an edge
  #      column (no right divider of its own to over-light).
  # Case 3 is the T-junction fix: when the state pane owns a full-height divider
  # bordering TWO stacked panes, tmux draws the segment below the junction in the
  # LOWER neighbour context, so that neighbour must also resolve lit or the far
  # half stays dim. The edge-column guard stops a 3-column middle divider from
  # lighting when only the left column holds the state. Partial overlaps leave
  # the flag 0 and defer to the native per-cell indicator (exact for 2x2 grids).
  #
  # ccol now INCLUDES active copy panes (it used to exclude them and lean on the
  # native @copy_active_w half-light) -- unifying with acol is what makes the
  # copy ring light fully while your focus is still inside the copy pane.
  # ROW flags include everything: title rows are outside the native indicator.
  for (i = 1; i <= n; i++) {
    arow = act[i]; crow = mode[i]; acol = act[i]; ccol = mode[i]
    if (act[i] && mode[i]) wmode[win[i]] = 1
    seen[win[i]] = 1
    for (j = 1; j <= n; j++) {
      if (j == i || win[j] != win[i]) continue
      if (!mode[j] && !act[j]) continue
      # j immediately RIGHT / LEFT / ABOVE of i, and whether j fully spans i,
      # and whether i is an edge column (no right divider of its own).
      right = (L[j] >= R[i] + 2 && L[j] <= R[i] + 3 && T[j] <= B[i] && B[j] >= T[i])
      left  = (R[j] <= L[i] - 2 && R[j] >= L[i] - 3 && T[j] <= B[i] && B[j] >= T[i])
      above = (T[i] >= B[j] + 2 && T[i] <= B[j] + 3 && L[j] <= R[i] && R[j] >= L[i])
      span  = (T[j] <= T[i] && B[j] >= B[i])
      # STRICT span: j reaches BEYOND i on at least one side, so a stacked
      # sibling shares the divider column and a real T-junction exists. When j
      # matches i exactly (a plain side-by-side split, one pane each side of the
      # divider) there is NO junction: the divider is wholly owned by the LEFT
      # pane and already lit by that panes own col flag, so the edge-column
      # guard must NOT fire. It used to fire on equal extents too, stamping ccol
      # on the right pane; if that pane was ALSO the active pane, pane-active-
      # border-style (which greens on copy_col) then lit its WHOLE ring lime -- a
      # non-copy active pane glowing green next to a copy pane. (bug 2026-07-24)
      strict = (T[j] < T[i] || B[j] > B[i])
      edge  = (R[i] >= maxR[win[i]])
      # The title row is a SINGLE-COLOUR fill spanning the whole pane width
      # (pane-border-format draws one run of the pane_width) -- it cannot be
      # half lime / half dim. So the neighbour above only lends its state when
      # it FULLY spans this pane (a real full-width lid); a partial overlap (a
      # narrower copy pane sitting above one side, e.g. top-left over a wide
      # bottom pane) would otherwise light the WHOLE line and over-claim the
      # half that borders a non-copy pane. Partial -> dim, not fully lit.
      # (bug 2026-07-24: bottom line fully green under a half-width copy pane)
      hspan = (L[j] <= L[i] && R[j] >= R[i])
      if (act[j]  && above && hspan)                  arow = 1
      if (mode[j] && above && hspan)                  crow = 1
      if (act[j]  && right && span)                   acol = 1
      # ACTIVE far-half: tmux native pane-border-indicator SPLITS a shared
      # divider and draws the half away from the active pane in the NEIGHBOUR
      # context, so that neighbour must carry acol or the far half stays dim
      # (the "only lights halfway" bug). No strict here: this is needed even for
      # equal-height side-by-side panes, where the far half is the whole other
      # side of the divider.
      if (act[j]  && left  && span && edge)           acol = 1
      # COPY far-half needs NO neighbour flag: copy mode has no native indicator,
      # so the divider is drawn wholly in its OWNER (left pane) context and the
      # copy pane own ccol lights all of it. The neighbour guard is therefore
      # only wanted for a genuine T-junction (strict span -> a stacked sibling
      # exists). Firing it on an equal-height neighbour that is ALSO the active
      # pane made pane-active-border-style green that panes whole ring. (strict)
      if (mode[j] && right && span)                   ccol = 1
      if (mode[j] && left  && span && strict && edge) ccol = 1
    }
    print "P", id[i], arow, crow, ccol, acol
  }
  # One line per window: is its ACTIVE pane in a mode? Read by the active
  # border style so the native active-adjacent cells go lime in place.
  for (w in seen) print "W", w, (w in wmode) ? 1 : 0
}' |
while read -r kind target a b c d; do
  if [ "$kind" = "W" ]; then
    tmux set-option -w -t "$target" @copy_active_w "$a"
  else
    tmux set-option -p -t "$target" @active_row "$a" \; \
         set-option -p -t "$target" @copy_row   "$b" \; \
         set-option -p -t "$target" @copy_col   "$c" \; \
         set-option -p -t "$target" @active_col "$d"
  fi
done
# Option writes do not force a border repaint on their own.
tmux list-clients -F '#{client_name}' 2>/dev/null | while IFS= read -r c; do
  tmux refresh-client -t "$c" 2>/dev/null
done
