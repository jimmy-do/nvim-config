#!/usr/bin/env bash
# Set the floax float's size, and REMEMBER it.  Usage: floax-size full | reset
#
# Three layers have to agree or the size does not stick:
#
#   1. FLOAX_WIDTH / FLOAX_HEIGHT   global tmux env, read when the popup is
#                                   created. What takes effect NOW.
#   2. @floax-width / @floax-height  tmux options, the plugin's fallback when
#                                   the env vars are empty.
#   3. floax-size.conf              a generated file sourced at the foot of
#                                   tmux.conf. The ONLY layer that survives a
#                                   tmux server restart -- 1 and 2 both die
#                                   with the server, which is why "full screen"
#                                   kept reverting to 80%.
#
# All three are written on every call. Do not drop the file write.
#
# NOT routed through the plugin's zoom-options.sh, deliberately: that script
# ends in a bare `tmux detach-client`, which is correct only when it runs from
# inside the popup and logs you clean out of tmux from anywhere else. Same trap
# floax-toggle guards. The cost is that a float already on screen has to be
# closed and reopened to pick up the new size; the banner says so.
set -u

BANNER=~/.config/nvim/dotfiles/tmux/banner
STATE=~/.config/nvim/dotfiles/tmux/floax-size.conf

case "${1:-}" in
    full)
        w=100%; h=100%; label="FULL SCREEN" ;;
    reset)
        w=80%;  h=80%;  label="80%" ;;
    *)
        "$BANNER" red 2000 "floax-size: expected 'full' or 'reset'"; exit 1 ;;
esac

# 1. live, for the next open
tmux setenv -g FLOAX_WIDTH  "$w"
tmux setenv -g FLOAX_HEIGHT "$h"

# 2. the plugin's option fallback
tmux set-option -g @floax-width  "$w"
tmux set-option -g @floax-height "$h"

# 3. across server restarts
cat > "$STATE" <<EOF
# GENERATED by floax-size -- do not hand-edit, it is rewritten on prefix F /
# prefix M-f. Sourced from the foot of tmux.conf so the float's size survives a
# tmux server restart.
set-option -g @floax-width  "$w"
set-option -g @floax-height "$h"
set-environment -g FLOAX_WIDTH  "$w"
set-environment -g FLOAX_HEIGHT "$h"
EOF

"$BANNER" green 1800 "FLOAT: ${label}  ·  remembered  ·  reopen it to apply"
