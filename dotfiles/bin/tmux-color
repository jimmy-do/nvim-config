#!/usr/bin/env python3
"""tmux-bar / tmux-color / tmux-chip / tmux-pane / tmux-pane-lines / tmux-copy /
tmux-float —
reskin tmux from `pill`.

    tmux-bar               list the colors, mark the active one
    tmux-bar turquoise     the BAR ITSELF: row 1 (the rule, the HUD, the
                           resize/prefix/copy/zoom cheatsheets) and the shared
                           chrome it publishes -- popup and menu frames, the
                           copy-mode mark, @ui-* (NOT the float -- see
                           tmux-float)
    tmux-bar -             back to the previous

    tmux-color amber       the bar's CONTENTS: inactive window labels and their
                           rail, plus status-right -- git/language context,
                           the DATE, and the clock chip

    tmux-chip synth_orange the two CHIPS: session name + active window
    tmux-chip auto         let THIS session go back to its automatic colour
                           (see PINNING, below)
    tmux-pane amber        pane TITLES: the pill, pane numbers, the clock
    tmux-pane-lines cyan   pane DIVIDERS: the borders
    tmux-float neon_pink   the SCRATCH FLOAT's frame (prefix o). Off the bar's
                           palette on purpose: on the bar's dim it was the same
                           hex as an unlit pane border and the float stopped
                           reading as a float. Pick by HUE, not brightness.
    tmux-copy matrix       COPY MODE, from one hex: the copy-tinted border and
                           pill, the COPY chip, the scrollbar thumb, and the
                           scrollbar track at SUNK_SCALE of it
                           (tmux-copymode-color is an alias for this)

`tmux-color` used to be a bare alias for `tmux-bar` -- an unrecognised argv[0]
fell through to the tmux-bar mode, so the two names painted the same block and
there was no way to say "keep the rule where it is, move the clock". They are
two surfaces now: tmux-bar is the bar's own frame, tmux-color is what is written
on it (inactive labels, date, clock).

Surfaces, commands, one palette. They are split where a surface can
sensibly disagree with its neighbour -- a hot chip on a quiet bar, a lit pane
title on a dim divider. Give them all the same colour and you get exactly what
one command would have produced. Each keeps its own previous, so `tmux-chip -`
never disturbs the bar and vice versa.

NONE of them changes a shape or a width. The caps, wedges, glyphs and padding
are fixed in the templates below; only colours are ever substituted.

One color in, two out: BRIGHT is the color itself (active window, session cap,
values, dividers, the lit pane border) and DIM is the same hue at 48% (labels,
inactive windows, the unlit border). 48% is the ratio the hand-tuned pairs
already in tmux.conf used -- #FF8500/#7a4000 and #03FC45/#017a22 are both it.

Dividers deliberately take BRIGHT, not DIM: they are the bar's structure, and
at DIM they disappeared into the background.

Colors come from the same `pill_*` table in ~/.config/starship.toml that `pill`
reads, so the prompt and the tmux chrome are always drawn from one palette.

PINNING (tmux-chip only). Session chips are normally auto-assigned by the
session-hue script -- deterministic per name, re-run on every new session and
every config reload. Without a pin, that reassignment silently overwrote any
manual `tmux-chip <colour>`, because it always wins the per-session vs. global
option resolution tmux does (see the note by the "tmux-chip" block below). A
manual colour change now also sets @session_hue and @session_hue_pin on the
CURRENT session directly, so session-hue skips it from then on. `tmux-chip
auto` clears the pin and hands the session back to session-hue immediately.

Each command rewrites ONLY the block between its own markers in tmux.conf. The
option lines inside those blocks are generated from the templates below --
hand-edits there are lost on the next switch. Edit this file instead.

This file is invoked under both names; tmux-bar and tmux-pane are symlinks.
"""
import os, re, sys, shutil, subprocess, tempfile

HOME = os.path.expanduser("~")
# Baked into the pane path template as a literal. tmux's s||| is a regex, so
# the substitution cannot read $HOME at match time -- and a generated config
# that hardcodes this machine's home is fine, since every other line in the
# managed blocks is generated for this machine too.
HOMEDIR = HOME
STARSHIP = f"{HOME}/.config/starship.toml"
TMUX_CONF = os.path.realpath(f"{HOME}/.tmux.conf")
STATE_DIR = os.environ.get("XDG_STATE_HOME", f"{HOME}/.local/state")

INK = "#080808"          # knockout text on a lit slab -- never recolored
DIM_SCALE = 0.48         # BRIGHT -> DIM
SUNK_SCALE = 0.20        # BRIGHT -> scrollbar trough
NUM_SCALE = 1.00         # Reactor Tag: fully lit angular index module
ION_BODY = "#101410"     # near-black body behind the neon label

# Placeholders inside the templates. NOT str.format: tmux formats are full of
# literal { } (#{?pane_active,...}) and would blow up on every brace.
B, D, S, I = "@@B@@", "@@D@@", "@@S@@", "@@I@@"
# The number is the lit angular module at the left edge of Reactor Tag. The
# remaining label sits on ION_BODY with neon foreground, joined by a hard
# Powerline cut that tmux can render perfectly at cell resolution.
NB, ND = "@@NB@@", "@@ND@@"

# Copy-mode accent. While the ACTIVE pane is in copy mode, its Reactor Tag pill
# (and its border, overridden in tmux.conf) take this instead of BRIGHT, so the
# pill matches the COPY chip in the status bar. This is a LIVE format reference,
# not a baked hex: it reads the @copy_mode_color option at every render, so
# editing that option (or `tmux-copymode-color <hex>`) recolours the pill with
# no regeneration. It carries no @@ token, so build_block() leaves it untouched.
CM = "#{@copy_mode_color}"

# The active chip's fill. Normally this is just the session hue; during a
# flicker, chip-flicker sets @session_hue_lit for a few frames and the chip
# follows it down and back. The conditional means the override is OPTIONAL --
# between flickers the option is unset and this resolves to the flat hue, so
# killing the script leaves the chip exactly as it was before it existed.
LIT = "#{?@session_hue_lit,#{@session_hue_lit},#{@session_hue}}"

# Chip edges, written as chr() -- a literal glyph in this source survives fine,
# but it is invisible in most diffs/editors, and a cap silently dropped from a
# template turns a shaped chip into a bare slab. Naming them keeps that from
# happening quietly.
#
# NEVER write one of these as a literal character through a shell heredoc. BMP
# private-use codepoints (U+E000-F8FF) are silently STRIPPED there, while
# supplementary-plane ones (U+F0000+, the Nerd Font icons) pass through -- so
# the damage looks random and lands on the caps only. That has cost this config
# real time more than once. chr() everywhere, and assert after writing.
#
# All of these are Powerline EXTRA (U+E0A3, U+E0B4-U+E0D4) -- the add-on set
# layered over Powerline's original four triangles (U+E0A0-U+E0B3) and bundled
# into every Nerd Font patch. Verified present in JetBrainsMonoNerdFont-*.ttf by
# reading the cmap directly; all 31 Extra glyphs are mapped.
#
# SURFACE SHAPES -- the bar wears slants, the pane pill wears rounded caps.
# That is what keeps the two surfaces telling apart at a glance when they are
# set to the same colour. Colour commands never touch these; edit here.
LCAP, RCAP = chr(0xE0B6), chr(0xE0B4)                       # rounded: pane pill
# ZOOMED caps. A zoomed pane is the ONLY pane on screen, so the surface has to
# say so with no neighbour to compare against -- the lit/unlit brightness step
# that flags the active pane cannot work when nothing else is visible. Shape
# carries it instead: the rounded caps square off into solid wedges and the
# lead-in rule goes heavy. Both are per-pane format conditionals, not options,
# because pane-border-lines is global and cannot vary by zoom state.
ZLCAP, ZRCAP = chr(0xE0B2), chr(0xE0B0)                     # solid: zoomed pill
# The pill's INTERNAL divide, between the index segment and the title segment.
#
# It MUST match the caps. The caps are rounded (U+E0B6/U+E0B4) and this was a
# shear (U+E0BC) -- a slanted cut between two round ends, which reads as two
# different widgets welded together. U+E0B4 is the same half-round the right
# cap uses, drawn here fg = LEFT segment's bg on bg = RIGHT segment's bg, so
# the index segment ends in the identical curve the pill itself ends in.
#
# Shape vocabulary, do not mix: the BAR wears slants (E0BA/E0BC), the PANE
# PILL wears rounds (E0B6/E0B4). That is the only thing telling the two
# surfaces apart when they are set to the same colour.
# The index/label divide is a thin rule drawn IN THE INK COLOUR on the single
# pill background -- not a background change. A mid-pill colour change needs a
# seam, and every seam shape tried (E0BC shear, E0B4 half-round) was louder
# than what it separated. This needs no join: it is just a character.
INKRULE = chr(0x2502)                                       # thin rule: index | label
ARROW = chr(0xE0B0)                                         # wedge: retired, kept
SLANT_L, SLANT_R = chr(0xE0BA), chr(0xE0BC)                 # solid: chips
SLANT_THIN = chr(0xE0BB)                                    # hairline: window rail

# State glyphs. These are Nerd Font icons (supplementary plane), not Powerline.
#
# ZOOM is U+F065, NOT U+26F6. U+26F6 is the "squared plus" the obvious search
# result recommends -- and it is NOT MAPPED in JetBrainsMono Nerd Font. Verified
# by reading the cmap: 11,756 codepoints, U+26F6 absent. It ships as a blank box.
# Checked alternates that ARE present, if the read ever wants changing:
#   U+F066 compress   U+EB81   U+F0294   U+F04DE   U+F0B2 arrows-alt
ZOOM = chr(0xF065)    # expand -- window is zoomed
# TALL is the @dimzoom state: not tmux's own zoom, a user-set flag for a pane
# grown to full height while its neighbours stay on screen. It gets its own
# branch because "prefix Z restores" is a different key from the real zoom's
# "prefix z". U+F07D is arrows-v, mapped in JetBrainsMono Nerd Font.
TALL = chr(0xF07D)    # arrows-v -- pane is height-zoomed via @dimzoom
BELL = chr(0xF0092)   # bell -- window rang
# ACT is U+25CF BLACK CIRCLE, a plain BMP dot -- NOT U+F111, the Nerd Font
# fa-circle it replaced. F111 is drawn at icon scale, which in this font is a
# pinprick next to the surrounding text; it read as a speck of dirt on the bar
# rather than a status light. 25CF is a text-weight glyph and sizes with the
# font, so it lands as a real dot. Verified in the cmap (11,756 codepoints).
# Checked and REJECTED because they are NOT mapped in JetBrainsMono Nerd Font
# and ship as blank boxes: U+26AB medium-black-circle, U+2B24 large-black-circle.
# Mapped alternates if this wants changing: U+F444, U+F0765, U+25CB (hollow).
# ACT is the WINDOW rail's activity dot and stays U+F111, untouched. It was
# briefly changed to the fisheye below; the window rail is not this command's
# to restyle, so it went back. Do not "unify" the two rails again.
ACT = chr(0xF111)     # solid dot -- window has unseen output (WINDOW RAIL)
# PANE_UNSEEN is the pane pill's own dot and is deliberately allowed to differ.
PANE_UNSEEN = chr(0x25C9)  # fisheye -- pane has output you have not seen
# 25C9 FISHEYE, a dot inside a ring, over the plain 25CF disc it replaced. Both
# size with the font; the ring is what makes it read as an indicator LIT rather
# than as a speck the terminal failed to clear. It also survives sitting on a
# filled slab, where a bare disc on a bright bg turns into a hole.
# Mapped, if this wants changing:  F444  F0765 󰝥  EA71   ◉ hollow ○ 25CB.
# NOT mapped, ships as a blank box, do not retry: 26AB 2B24 2739 2726.

# Last window: a RETURN arrow, not a chevron and not a dot.
#
# The job of this mark is not "something happened here" -- nothing happened
# here, that is the point. It means "you were just in this window and prefix-;
# takes you straight back". A return arrow says that; a dot says news, which is
# what made the earlier version read as the exact opposite of its meaning.
# Alternates that are also in the font, if this reads wrong at size:
#   U+F053   chevron-left     U+F0450 󰑐 history
#   U+F0721 󰜡 arrow-u-left-top U+F0141 󰅁 mdi chevron-left
# Used on BOTH rails -- window_last_flag on the bar, pane_last in the pill --
# so a mark means the same thing wherever it appears. Do not fork these.
PREV = chr(0xF112)    # reply arrow -- last window/pane, one keystroke back
REMOTE = chr(0xF08B9)  # network -- pane is ssh/mosh/sudo, keystrokes leave here
# MARKED is the pane tmux holds for swap-pane/join-pane (prefix m). tmux gives
# it no visible mark of its own beyond reversing the border, which is invisible
# on a one-cell rule -- so the badge carries it. Only ever ONE pane server-wide.
# The SAME glyph the window rail uses for window_last_flag -- PREV above. It
# was briefly F0721, which renders as a mangled box at this size; there was no
# reason to invent a second arrow when the rail already had one that works.
LAST_PANE = PREV      # reply arrow -- the pane prefix ; goes back to
# YOU ARE HERE. Text-weight so it sizes with the digit beside it, and a solid
# body so it reads at a glance -- it echoes the ">" the window rail puts on the
# current window, which is the same statement one level up. It shares a slot
# with {LAST_PANE} and can never collide: the active pane is never the pane
# prefix ; goes back to.
HERE = chr(0xEEA7)    # laptop-with-code -- this is the pane you are in
DEAD = chr(0xF00D)     # cross -- pane's process exited (needs remain-on-exit)
MARKED = chr(0xF08D)   # thumbtack -- this is the marked pane

MODES = {
    "tmux-bar": {
        "begin": "# >>> tmux-bar-managed >>>",
        "end": "# <<< tmux-bar-managed <<<",
        # The bar's FRAME, not its contents. Row 1 (the rule, the HUD and the
        # mode cheatsheets) plus the chrome the bar publishes for everything
        # else -- popups, menus, the float, the copy mark, @ui-*. The inactive
        # labels, the rail and status-right moved out to `tmux-color`, which is
        # the whole reason that name stopped being an alias for this one.
        "what": "the bar itself (row 1 + chrome)",
        "lines": [
            # Row 1 is TRANSIENT: silent unless something is true. Branches, in
            # priority order -- resize table, prefix pending, copy mode, zoomed,
            # else the rule. Resize wins because you are IN it; prefix beats the
            # rest because it is the most fleeting.
            #
            # Every branch is a slab + {SLANT_R} tail, the same shear the chips
            # wear, so row 1 reads as part of the same bar rather than a popup.
            #
            # Styles are written as separate #[..] blocks on purpose. A comma
            # inside #[..] that sits inside a #{?..} is read as the conditional's
            # branch separator and has to be escaped #, -- splitting the blocks
            # sidesteps that entirely, and this format is four conditionals deep.
            # Every chip on this row wears the SAME shape as the prefix chip that
            # already existed -- {LCAP} ... {RCAP}, rounded both ends. Row 0's
            # window chips are sheared, row 1's mode chips are rounded, and that
            # difference is the only thing distinguishing the two rows at a
            # glance. All of them are bold, dots included.
            f'set -g status-format[1] "#{{?#{{==:#{{client_key_table}},resize}},'
            f'#[fg={B}]#[bg=default]{LCAP}#[fg={I}]#[bg={B}]#[bold] RESIZE #[fg={B}]#[bg=default]#[nobold]{RCAP}  '
            f'#[fg={B}]#[bg=default]h/j/k/l#[fg={D}] 1 cell  ·  '
            f'#[fg={B}]H/J/K/L#[fg={D}] 5 cells  ·  '
            f'#[fg={B}]Esc / q / Enter#[fg={D}] done,'
            # Prefix pending: the keys you would otherwise reach for prefix-/ to
            # remember. Same pink as prefix_highlight -- MODE is pink everywhere.
            # NO chip here. tmux-prefix-highlight's WAIT chip lives in
            # status-left and always has; drawing a second one on this row put
            # two mode chips on screen at once. Row 1 carries only the keys.
            f'#{{?client_prefix,'
            # Groups are separated by ` · `, not by spaces. With spaces alone the
            # row read as one run of words -- "split - split o float" -- because
            # the gap between a label and the NEXT key was the same size as the
            # gap between a key and its OWN label. The dot is the same separator
            # the resize row uses, so both cheatsheets parse the same way.
            f'#[fg={B}]|#[fg={D}] split  ·  #[fg={B}]-#[fg={D}] split  ·  '
            f'#[fg={B}]o#[fg={D}] float  ·  #[fg={B}]g#[fg={D}] sesh  ·  '
            f'#[fg={B}]f#[fg={D}] find  ·  #[fg={B}]/#[fg={D}] keys  ·  '
            f'#[fg={B}]r#[fg={D}] resize  ·  #[fg={B}]t#[fg={D}] weather,'
            # Tree mode (prefix-w): its keys are hardcoded in mode-tree.c and
            # unrebindable, so this row is the only teachable surface -- the
            # cheatsheet the tree itself cannot show. Checked BEFORE the
            # generic pane_in_mode branch, which would otherwise claim the
            # tree and show copy-mode keys (v/y) that mean nothing here.
            f'#{{?#{{==:#{{pane_mode}},tree-mode}},'
            f'#[fg={B}]Enter#[fg={D}] go  ·  #[fg={B}]+/-#[fg={D}] fold  ·  '
            f'#[fg={B}]C-s#[fg={D}] search  ·  #[fg={B}]n/N#[fg={D}] match  ·  '
            f'#[fg={B}]f#[fg={D}] filter  ·  #[fg={B}]m#[fg={D}] mark  ·  '
            f'#[fg={B}]t#[fg={D}] tag  ·  #[fg={B}]:#[fg={D}] cmd  ·  '
            f'#[fg={B}]x#[fg={D}] kill  ·  #[fg={B}]O#[fg={D}] sort  ·  '
            f'#[fg={B}]S-↑↓#[fg={D}] move win  ·  '
            f'#[fg={B}]C-a ?#[fg={D}] HELP  ·  #[fg={B}]q#[fg={D}] out,'
            # Copy mode: position takes BRIGHT because it is the live value.
            f'#{{?pane_in_mode,'
            f'#[fg={B}]#{{scroll_position}}#[fg={D}] up  ·  '
            f'#[fg={B}]n/N#[fg={D}] match  ·  #[fg={B}]v#[fg={D}] select  ·  '
            f'#[fg={B}]y#[fg={D}] yank  ·  #[fg={B}]Esc#[fg={D}] out,'
            # Zoomed: the one branch that is not about keys but about a lie the
            # screen is telling you -- the pane you see is not its real size.
            f'#{{?window_zoomed_flag,'
            f'#[fg={B}]#[bg=default]{LCAP}#[fg={I}]#[bg={B}]#[bold] {ZOOM} ZOOMED '
            f'#[fg={B}]#[bg=default]#[nobold]{RCAP}  '
            f'#[fg={B}]#{{pane_current_command}}#[fg={D}] · #{{b:pane_current_path}}'
            f'  #[fg={D}]prefix z restores,'
            # Height-zoom (@dimzoom): same slab, different icon and different
            # restore key. Kept as its own branch below the real zoom so the
            # two states can never both claim the row.
            f'#{{?@dimzoom,'
            f'#[fg={B}]#[bg=default]{LCAP}#[fg={I}]#[bg={B}]#[bold] {TALL} TALL '
            f'#[fg={B}]#[bg=default]#[nobold]{RCAP}  '
            f'#[fg={B}]#{{pane_current_command}}#[fg={D}] · #{{b:pane_current_path}}'
            f'  #[fg={D}]prefix Z restores,'
            # The else-branch rule. BRIGHT, like the dividers: it is the bar's
            # baseline, and at dim it vanished into the terminal background.
            # (A truecolor gradient version was tried 2026-07-22 and rejected
            # as ugly -- flat is the look. Don't rebuild it.)
            #
            # HUD, right-aligned OVER the rule: pane count, window count,
            # client size -- dim, format-native only. NO #() here, ever: jobs
            # inside this row's nested conditionals silently fail to render
            # (the glow-rule lesson), so the HUD carries only what tmux can
            # answer without a shell.
            f'#[fg={B}]#[bg=default]#{{R:═,#{{client_width}}}}'
            f'#[align=right]#[fg={D}]  #{{window_panes}} pane#{{?#{{>:#{{window_panes}},1}},s,}}'
            f'  ·  #{{session_windows}} win  ·  #{{client_width}}×#{{client_height}}  '
            f'}}}}}}}}}}}}"',
            # --- chrome that used to drift ---------------------------------
            # Popup and menu frames, the floax float, and the copy-mode mark
            # were all hand-set. They survived two palette migrations by being
            # invisible at rest -- you only see them once a popup is open -- and
            # were still holding a cyan that had been retired twice over. They
            # are generated now, so they cannot be left behind again.
            f'set -g popup-border-style "fg={D}"',
            f'set -g menu-border-style  "fg={D}"',
            # @floax-border-color USED to be written here, taking {D} -- which
            # made the float's frame byte-identical to an unlit pane border, so
            # the scratch float read as just another pane. It is its own surface
            # with its own command now: see the tmux-float block.
            f'set -g copy-mode-mark-style "bg={B},fg={I}"',
            # Published for anything that cannot take a generated line: the sesh
            # picker builds its fzf --color from these at popup time, so it
            # follows the palette without needing its own block.
            f'set -g @ui-bright "{B}"',
            f'set -g @ui-dim "{D}"',
            f'set -g @ui-sunk "{S}"',
        ],
    },
    "tmux-color": {
        "begin": "# >>> tmux-color-managed >>>",
        "end": "# <<< tmux-color-managed <<<",
        # What is WRITTEN on the bar: the inactive window labels and the rail
        # between them, and status-right -- git/language context, the date, and
        # the clock chip. Everything here is either dim-by-definition (the
        # things you are not looking at) or a reading (the things that tick),
        # which is why they share one command and the frame does not.
        "what": "inactive windows + date/clock",
        "lines": [
            # Right: kube context ╱ git branch ╱ clock. Labels dim, values
            # bright, dividers bright.
            # The kube context is rendered by a helper, not inlined, because it
            # styles itself: a context matching prod/prd/production/live flips to
            # void-on-orange instead of taking the bar colour. The hue budget is
            # full, so "you are pointed at production" is said with INVERSION.
            #
            # tmux DOES interpret #[..] emitted by a #() hook -- verified by
            # probe (inner tmux captured from an outer pane; the escape run came
            # back 38;2;8;8;8 over 48;2;255;133;0). Don't re-litigate it.
            f'set -g status-right "'
            # git branch/dirty + language versions for the ACTIVE pane's dir,
            # rendered by the status-context helper. This is where the retired
            # git + language prompt segments now live (kubectl stayed in the
            # prompt). It self-styles, prints nothing for a plain directory, and
            # emits its own trailing space before the clock chip below.
            f"#(~/.config/nvim/dotfiles/tmux/status-context '#{{pane_current_path}}')"
            # Weekday + numeric date, DIM and OUTSIDE the pill. It changes once a
            # day, so it is context, not a reading -- the bright chip stays
            # reserved for the thing that actually ticks. NO YEAR on purpose.
            # %-m/%-d (not %m/%d) drop the leading zeros: "7/5", not "07/05".
            f'#[fg={D}]#[bg=default]%a %-m/%-d '
            # Single space before the clock chip (the helper emits one trailing
            # space, which is enough) and a 12-hour AM/PM clock, not 24h.
            # %-l (not %l) = no-pad hour, so no phantom space inside the pill.
            f'#[fg={B}]#[bg=default]#[bold]%-l:%M:%S %p#[nobold]"',
            # The rail between inactive windows: the hairline slant, U+E0BB.
            # It leans the same way as the chip shear, so the whole window strip
            # reads as one cut instead of a chip shape plus an unrelated ASCII-ish
            # divider. The ╱ rails in status-right are left alone on purpose --
            # those separate VALUES, not chips, and a chip edge there would imply
            # a boundary that is not one.
            # Exported so another surface can borrow this one's pair without
            # baking a hex -- the same reason tmux-pane-lines exports
            # @pane_lines_bright/@pane_lines_dim. Nothing reads these today; a
            # tab style that repaints the inactive labels would, and having the
            # pair on an option is what lets it do that without baking a hex.
            # Still named @bar_* though they are written by `tmux-color` now:
            # they are the WINDOW RAIL's pair and always were, and renaming an
            # option nothing reads only breaks the one thing that might.
            f'set -g @bar_bright "{B}"',
            f'set -g @bar_dim "{D}"',
            # DIM, not bright. The active chip already ends in a solid shear, so
            # a BRIGHT rail landing immediately after it read as a doubled edge
            # -- two lit diagonals a space apart, which looks like a rendering
            # fault rather than a divider. Dropping the rail to DIM puts one lit
            # edge on screen (the chip's) and leaves the rail as the quiet thing
            # it is. It also stops every gap in the window strip glowing.
            f'set -g window-status-separator "#[fg={D}] {SLANT_THIN} #[default]"',
            # Inactive windows stay DIM. Always.
            #
            # An earlier version promoted a window with unseen output to BRIGHT,
            # on the theory that activity is news. It is not: on this machine
            # background windows run agents, logs and builds, so at any moment
            # roughly three windows in four carry the activity flag. Promoting
            # them lit the whole strip, and a signal that is true most of the
            # time is not a signal -- it is a wall. Worse, it drowned the one
            # thing the strip exists to show, which is where you actually are.
            #
            # So brightness stays reserved for the current window's chip, and
            # news is a ONE-CELL marker at the end of the label instead:
            #   {BELL}  bell rang        BRIGHT -- rare, and asked for you
            #   •       unseen output    BRIGHT -- common, so kept tiny
            #   ·       last window      DIM
            #   space   nothing
            # Exactly one cell in every case, so labels never change width as
            # flags come and go. That jitter was the other half of the mess.
            f'set -g window-status-format "'
            f'#[fg={D}]#[bg=default]'
            # RETURN ARROW ON THE LEFT, news on the right. The two marks answer
            # different questions and now sit on different sides of the label:
            # left is navigation (how do I get back), right is state (what
            # happened here). Reading inward from either edge gets you one
            # answer without the other in the way.
            #
            # Two cells, always -- space + arrow, or two spaces -- so the label
            # cannot change width as the flag moves from window to window. With
            # the leading space that already belonged to the name, both edges
            # carry three cells at rest, which is what keeps the row symmetric.
            # TWO spaces after the arrow, not one. These Nerd Font marks are
            # East-Asian-ambiguous, so tmux lays them out as one cell while the
            # font draws them nearly two wide -- the glyph overhangs its cell and
            # eats a single separating space, leaving the arrow welded to the
            # window icon. Cell arithmetic says the space is there; the screen
            # says otherwise, and the screen is the one being read.
            f'#{{?window_last_flag,#[fg={D}] {PREV}  ,    }}'
            f'#{{E:@window_icon}} #I:#W'
            # The activity dot is gated on the OPTION as well as the flag.
            # Turning monitor-activity off does not clear flags already set --
            # tmux keeps them until you visit the window -- so without the gate,
            # switching monitoring off leaves stale dots sitting on the bar with
            # nothing able to clear them. #{monitor-activity} reads the live
            # option, so the marker disappears the instant it is switched off and
            # comes back the instant it is switched on.
            # #{window_flags}, tmux's own. It already encodes every state that
            # was hand-rolled here and then thrown away again: - last, # activity,
            # ! bell, Z zoomed, M marked, * current. One conditional, one cell,
            # semantics maintained upstream. The replacement markers invented
            # here were strictly worse -- a dot keyed on window_last_flag read as
            # "has news" while meaning "you just left this". Don't re-invent it.
            # Flags as GLYPHS, one cell, priority-ordered. tmux's stock
            # #{window_flags} run is right about the semantics and wrong about
            # the typography -- # ! Z M read as punctuation dropped into the
            # name. Same meanings, drawn properly:
            #
            #   {BELL}  bell rang          rare and deliberate, so it wins
            #   {ACT}   unseen output      any output since you last looked,
            #                             except idle Vim/Neovim redraws
            #   {PREV}  last window        a RETURN arrow, not a dot: nothing
            #                              happened here, it just means prefix-;
            #                              goes straight back
            #   space   nothing
            #
            # Zoom is not in this cell -- the zoom glyph rides on the active
            # window's chip, which is the only window that can be zoomed.
            # Note the leading space inside EVERY branch. Without it the marker
            # sat hard against the last letter of the window name -- "2:foo"
            # rather than "2:foo ". Every branch is two cells (space + mark) so
            # the labels still cannot change width as flags come and go.
            # TWO INDEPENDENT SLOTS, not one priority chain. A window can be
            # both the one you just left AND have printed something since, and
            # those are different facts -- the news mark used to swallow the
            # return mark whenever they coincided, which is exactly when you
            # most want to see both.
            #
            #   left slot    {PREV} last window, else blank   (see above)
            #   right slot   {BELL} bell, else {ACT} unseen output, else blank
            #
            # Bell still outranks activity INSIDE the right slot -- they are both
            # "something happened here", so they share one cell and the rarer,
            # deliberate one wins. The return arrow was never news, which is why
            # it no longer competes for that cell at all.
            f'#{{?window_bell_flag,#[fg={B}] {BELL},'
            # Vim/Neovim receive FocusLost on every tmux window switch and may
            # answer with terminal redraw/control output. tmux records that as
            # activity after the window has become inactive, so an untouched
            # editor immediately acquired a sticky "work" dot. Keep monitoring
            # enabled for real background jobs, but suppress the marker when the
            # window's active pane is resting in Vim/Neovim.
            f'#{{?#{{&&:#{{window_activity_flag}},'
            f'#{{==:#{{m/ri:^(n?vim)$,#{{pane_current_command}}}},0}}}},'
            f'#[fg={B}] {ACT},  }}}}'
            f' #[default]"',
        ],
    },
    "tmux-chip": {
        "begin": "# >>> tmux-chip-managed >>>",
        "end": "# <<< tmux-chip-managed <<<",
        "what": "session + window chips",
        "lines": [
            # The session chip: a lit slab sheared off by {SLANT_R} (U+E0BC).
            # It used to wear {ARROW}, the full U+E0B0 wedge, on the argument
            # that its shape had to differ from the window chip's. It does not:
            # the session chip is already unmistakable -- it is the only chip on
            # the left, the only one in uppercase, and the only one that is lit
            # unconditionally. Shape was doing no work there, so both chips now
            # take the same shear and the bar reads as one cut.
            # SESSION IDENTITY HUES: both chips draw their colour from the
            # session-scoped @session_hue option, not from a baked hex. The
            # session-hue script (hooked on session-created, and at config
            # load, in tmux.conf below this block) assigns each session a
            # deterministic colour from a curated neon set, so which-session-
            # am-I-in is preattentive -- with the bloom shader, each session
            # literally has its own aura. The line below sets the GLOBAL value
            # of @session_hue, which tmux uses as the fallback for any session
            # the script has not touched -- so `tmux-chip <color>` still works
            # and now means "the default session colour".
            f'set -g @session_hue "{B}"',
            f'set -g status-left "#[fg={I},bg=#{{@session_hue}},bold] '
            f"#(echo '#{{session_name}}' | tr a-z A-Z) "
            f'#[fg=#{{@session_hue}},bg=default,nobold]{SLANT_R}#[default] #{{prefix_highlight}} "',
            f'set -g window-status-current-style "bg=default,fg=#{{@session_hue}},bold"',
            # The active-window chip itself is drawn by the tab STYLE, appended
            # below this list by build_block -- along with the inactive format
            # and the separator, which the style owns for the reason in the
            # TAB_STYLES note.
        ],
    },
    "tmux-pane": {
        "begin": "# >>> tmux-pane-managed >>>",
        "end": "# <<< tmux-pane-managed <<<",
        "what": "pane titles",
        "lines": [
            # ONE PILL, ONE BACKGROUND.
            #
            # The index used to sit in its own darker segment, joined to the
            # title by a separator glyph. Every version of that join looked
            # broken: a shear between two rounded caps read as two widgets
            # welded together, and the matching half-round read as a bite taken
            # out of the pill. The lesson is that a mid-pill background change
            # needs a seam, and any seam on a shape this small is louder than
            # the thing it separates.
            #
            # So the pill is one solid colour cap to cap, exactly like the
            # window chip on the bar above it, and the index is separated from
            # the label by a thin INK rule -- a mark drawn IN the text colour on
            # the one background, which needs no join at all.
            #
            # BLAST RADIUS. Green -- or whatever this surface is set to -- means
            # "you are on this box". When the pane's foreground process is
            # ssh/mosh/sudo/doas/su the same keystrokes have different
            # consequences, so the whole pill switches to #FF8500 and wears
            # {REMOTE}. The match is anchored ^..$ against pane_current_command,
            # so a pane sitting in a directory named "ssh" is not flagged and it
            # clears itself the moment the remote session exits.
            #
            # DEAD wins over everything: with remain-on-exit a crashed pane is
            # visually identical to an idle one, so it takes the same orange and
            # says what the exit code was.
            #
            # ON/OFF holds throughout -- active panes take the lit value,
            # inactive the dim, so COLOUR alone carries focus. Weight does not:
            # the inactive pill used to drop to nobold, which made its label
            # thinner as well as darker and read as a rendering artefact rather
            # than a state. Every pill is bold. Shape carries
            # zoom instead, since a zoomed pane has no neighbour to be brighter
            # than: caps square off and the lead-in rule goes heavy.
            #
            # Badge marks, in fixed order -- state you can act on, then
            # navigation: {MARKED} pane_marked, {LAST_PANE} pane_last.
            # pane_last is gated on window_panes > 1, because tmux pins it to
            # one pane per window unconditionally and in a single-pane window
            # there is nowhere for prefix ; to go.
            # NO LEAD-IN RULE. The pill used to sit behind "──", and that is
            # what stopped it looking flush: U+2500 draws a thin stroke through
            # the VERTICAL CENTRE of its cell while the pill fills the cell top
            # to bottom, so the rule met the cap at its waist and the whole
            # thing floated a couple of columns in from the pane edge. The pill
            # now starts at column 0, flush with the pane's left edge, with
            # nothing beside it to misalign against.
            #
            # Zoom therefore lives entirely in the CAP SHAPE now (rounded ->
            # solid wedge); the heavy rule that used to double up on that
            # signal went with the lead-in.
            f'set -g pane-border-format '
            f'"'
            # noreverse first: the marked-square fix (see the pane_marked
            # `reverse` prefix on the border styles above the tmux-pane block)
            # pre-sets reverse in the base style so tmux's hardcoded XOR on the
            # marked pane's border cells cancels out. Format-drawn cells skip
            # the XOR but inherit the base attr, so the format sheds it here.
            # No-op whenever nothing is marked.
            f'#[noreverse]'
            # --- ONE colour decision, made once, used by cap + body + cap ---
            f'#{{?#{{||:#{{pane_dead}},'
            f'#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}}}},'
            f'#{{?pane_active,#[fg=#FF8500],#[fg=#7a4000]}},'
            f'#{{?pane_active,#{{?pane_in_mode,#[fg={CM}],#[fg={NB}]}},#[fg={ND}]}}}}'
            f'#{{?pane_zoomed_flag,{ZLCAP},{SLANT_L}}}'
            f'#{{?#{{||:#{{pane_dead}},'
            f'#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}}}},'
            f'#{{?pane_active,#[fg={I}#,bg=#FF8500#,bold],#[fg={I}#,bg=#7a4000#,bold]}},'
            f'#{{?pane_active,#{{?pane_in_mode,#[fg={I}#,bg={CM}#,bold],#[fg={I}#,bg={NB}#,bold]}},#[fg={I}#,bg={ND}#,bold]}}}}'
            # ONE leading space, and ONE trailing on a bare digit (below): a
            # space on each side is what actually centres the number. Flush on
            # both sides was tried and read as shoved LEFT -- the slant cap eats
            # its own corner, so a digit sitting hard against it looks off to the
            # left, not centred. Symmetric padding, not zero padding, is centre.
            f' #{{pane_index}}'
            f'#{{?pane_marked, {MARKED} ,}}'
            # Trailing space is CONDITIONAL: the glyph branches carry a second
            # one, the bare branch does not.
            #
            # Every glyph that can land here -- HERE, LAST_PANE, MARKED -- is
            # East-Asian width "Ambiguous", which the font draws at roughly two
            # cells while tmux counts it as one. So the glyph bleeds into the
            # single trailing space and the number field ends flush against the
            # label's edge. A bare digit has no such bleed and sits correctly on
            # the single shared trailing space at the end of this group.
            # HERE badge removed 2026-08-13: U+EEA7 renders as tofu in this
            # font, and colour already carries focus (see ON/OFF note above).
            f'#{{?pane_active,,'
            f'#{{?#{{&&:#{{pane_last}},#{{>:#{{window_panes}},1}}}}, {LAST_PANE} ,}}}} '
            # Hard diagonal cut from the lit index module into the dark body.
            f'#{{?#{{||:#{{pane_dead}},'
            f'#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}}}},'
            f'#{{?pane_active,#[fg=#FF8500#,bg={ION_BODY}],#[fg=#7a4000#,bg={ION_BODY}]}},'
            f'#{{?pane_active,#{{?pane_in_mode,#[fg={CM}#,bg={ION_BODY}],#[fg={B}#,bg={ION_BODY}]}},#[fg={D}#,bg={ION_BODY}]}}}}'
            f'{SLANT_R}'
            # --- back to the pill colour for the label ---
            f'#{{?#{{||:#{{pane_dead}},'
            f'#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}}}},'
            f'#{{?pane_active,#[fg=#FF8500#,bg={ION_BODY}#,bold],#[fg=#7a4000#,bg={ION_BODY}#,bold]}},'
            f'#{{?pane_active,#{{?pane_in_mode,#[fg={CM}#,bg={ION_BODY}#,bold],#[fg={B}#,bg={ION_BODY}#,bold]}},#[fg={D}#,bg={ION_BODY}#,bold]}}}}'
            # Flat edge: the number field's own bg (NB/ND) meets the label bg
            # directly, no separator glyph. Chevron/wedge/half-round were each
            # tried here and cut -- the plain tone step reads cleanest.
            #
            # ONE leading space here + ONE trailing after the label (see the
            # right cap below): a space on each side centres the name in the dark
            # body, matching the index. Flush both sides read as shoved left.
            f' '
            f'#{{?#{{E:@pane_icon}},#{{E:@pane_icon}} ,}}'
            # DEAD first, then ssh, then the ordinary label.
            f'#{{?pane_dead,{DEAD} exit #{{pane_dead_status}},'
            f'#{{?#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}},'
            f'{REMOTE} ,}}'
            # A NAME set with `prefix <` wins over the automatic label, and it
            # is stored in the pane-local user option @pane_name, NOT in
            # pane_title.
            #
            # WHY NOT pane_title -- it does not stay set. `allow-rename off`
            # gates WINDOW renaming only; pane_title is still writable by any
            # program via an OSC escape, and several here do write it: Ghostty's
            # shell integration puts ":/Users/..." there on every prompt, and
            # agents put a spinner frame + task line there. So a title set by
            # hand survived only until the next prompt drew. That is the
            # "I renamed it and it renamed itself back" behaviour.
            #
            # A user option has no OSC equivalent -- nothing running inside the
            # pane can reach it -- so a name set here stays set, which is what
            # the `# No automatic renaming. Names I set stay set.` block in
            # tmux.conf already claims for windows.
            #
            # The pane_title fallbacks below are KEPT, and still matter: they
            # are what an unnamed pane shows, and they still have to defend
            # against exactly the OSC writers described above.
            f'#{{?#{{E:@pane_name}},#{{E:@pane_name}},'
            # tmux gives every pane the hostname as a title and offers no
            # "unset", so "has a name" means "neither the hostname nor empty".
            # Path-shaped titles count as unset too: zsh writes ":/Users/..."
            # on every prompt, which is not a name anyone chose.
            f'#{{?#{{||:#{{==:#{{pane_title}},#{{host}}}},'
            f'#{{||:#{{==:#{{pane_title}},}},'
            f'#{{m/r:^:?/,#{{pane_title}}}}}}}},'
            # project/…/leaf -- the shortest form that tells three terraform
            # panes apart, where a bare basename made them all read "local".
            # The backrefs need FOUR backslashes here to survive as two in
            # tmux.conf: \1 is an octal escape to BOTH parsers -- Python turns
            # it into \x01, and tmux.conf rejects it outright.
            f'#{{=/40:#{{s|^~/([^/]+)/.*/([^/]+)$|\\\\1/…/\\\\2|:'
            f'#{{s|^{HOMEDIR}|~|:pane_current_path}}}}}},'
            # Agents write a spinner frame into the title via OSC; strip one
            # leading non-alphanumeric char and its space, or a frozen frame
            # sits there looking like a permanently lit icon.
            f'#{{s/^[^0-9A-Za-z] //:pane_title}}}}}}}}'
            # Trailing space: the partner to the leading one above, so the name
            # sits centred in the dark body instead of hard against the cap.
            f' '
            # --- right cap, same colour decision as the left ---
            f'#{{?#{{||:#{{pane_dead}},'
            f'#{{m/r:^(ssh|mosh|sudo|doas|su)$,#{{pane_current_command}}}}}},'
            f'#{{?pane_active,#[fg={ION_BODY}#,bg=default#,nobold],'
            f'#[fg={ION_BODY}#,bg=default#,nobold]}},'
            f'#{{?pane_active,#[fg={ION_BODY}#,bg=default#,nobold],'
            f'#[fg={ION_BODY}#,bg=default#,nobold]}}}}'
            f'#{{?pane_zoomed_flag,{ZRCAP},{SLANT_R}}}'
            # TITLE-ROW LINE FILL. The rest of this row used to be filled by
            # tmux with pane-border-style -- the same option that colours the
            # vertical dividers -- which made per-segment ring lighting
            # impossible (a pane whose divider touched the active pane also
            # lit its unrelated title row). The format now draws its own fill:
            # an over-long run of ─ truncated at the pane edge, coloured by
            # the ROW flags (@active_row/@copy_row, stamped by copy-ring),
            # priority copy > active(+prefix cyan) > dim. All colours are
            # LIVE option references (@pane_lines_*, @copy_mode_color,
            # @prefix_highlight_bg), so this surface keeps tracking
            # tmux-pane-lines and the chip without regeneration.
            f'#{{?#{{@copy_row}},#[fg=#{{@copy_mode_color}}],'
            f'#{{?#{{@active_row}},'
            f'#{{?#{{@prefix_active}},#[fg=#{{@prefix_highlight_bg}}],#[fg=#{{@pane_lines_bright}}]}},'
            f'#[fg=#{{@pane_lines_dim}}]}}}}'
            f'#{{R:─,#{{pane_width}}}}#[default]"',
            f'set -g display-panes-colour        "{D}"',
            f'set -g display-panes-active-colour "{B}"',
            f'set -g clock-mode-colour           "{B}"',
        ],
    },
    "tmux-pane-lines": {
        "begin": "# >>> tmux-pane-lines-managed >>>",
        "end": "# <<< tmux-pane-lines-managed <<<",
        "what": "pane dividers",
        "lines": [
            # UNLIT vs LIT is the whole point -- see the long note above these
            # in tmux.conf. Same hue, brightness alone carries which pane is
            # active, so bright/dim here is load-bearing, not decoration.
            f'set -g pane-border-style        "fg={D}"',
            f'set -g pane-active-border-style "fg={B}"',
            # Exported so the copy-mode border override below the managed block
            # can use THIS surface's bright as its not-in-copy-mode colour --
            # otherwise it would have to hardcode a hex or borrow @ui-bright (the
            # bar's colour), and the active divider would stop tracking this
            # command. The override reads @pane_lines_bright; recolouring here
            # therefore still moves the focused divider.
            f'set -g @pane_lines_bright "{B}"',
            f'set -g @pane_lines_dim "{D}"',
            # The scrollbar USED to be written here, taking {S} -- the trough of
            # the PANE palette -- under a thumb hardcoded to the copy lime, which
            # put two accents on one widget whenever the panes were not lime. It
            # only ever appears in copy mode, so it belongs to the copy accent
            # and now lives in the tmux-copy block below.
        ],
    },
    "tmux-float": {
        "begin": "# >>> tmux-float-managed >>>",
        "end": "# <<< tmux-float-managed <<<",
        "what": "scratch float frame",
        "lines": [
            # The float's frame, and the ONE surface that is deliberately not
            # downstream of `tmux-bar`. It used to be written from the bar's DIM,
            # which made it byte-identical to an unlit pane border -- the float
            # then read as just another pane, which is the whole thing it is not.
            # Give this an OFF-HUE accent, not a shade of the panes: separation
            # here is hue, not brightness (the opposite of the lit/unlit rule the
            # pane dividers obey, because there is no neighbour to compare to --
            # the float is alone on top of whatever it covers).
            f"set -g @floax-border-color '{B}'",
            # floax reads its options into env at plugin load and again per open,
            # so a plain `set` is enough -- no reopen needed beyond the next
            # prefix-o. popup-border-style / menu-border-style are NOT touched:
            # those are the weather / msg / keys / sesh popups, which belong to
            # the bar's palette and should keep following it.
        ],
    },
    "tmux-copy": {
        "begin": "# >>> tmux-copy-managed >>>",
        "end": "# <<< tmux-copy-managed <<<",
        "what": "copy-mode accent",
        "lines": [
            # ONE hex drives all three. The border and Reactor Tag pill of a
            # pane in copy mode, and the COPY chip in the status bar, all read
            # #{@copy_mode_color} live at render -- so setting this option is
            # the whole job for them, no baked hexes anywhere.
            f"set -g @copy_mode_color '{B}'",
            # The scrollbar is the exception, and the reason this block is
            # generated rather than a one-line edit: pane-scrollbars-style is a
            # STYLE, not a format. It will NOT expand #{@copy_mode_color} -- it
            # silently draws nothing -- so both halves must be baked, which
            # means they can drift out of sync with the option above. Generating
            # all three from one input is what makes drift impossible.
            #
            # fg is the slider (the thumb you drag), bg the rest of the track.
            # The trough is the accent at SUNK_SCALE, the same 20% sink the pane
            # palette uses for its own troughs -- a lit thumb in a dark bed of
            # its own hue, which is how a scrollbar is meant to read.
            f'set -g pane-scrollbars-style "bg={S},fg={B},width=1,pad=0"',
            # The SELECTION and the SEARCH MATCHES, folded in 2026-07-26. They
            # are copy mode's two other painted surfaces and were the last
            # baked hexes on it -- a pale cyan selection and an amber current
            # match, both left over from palettes retired twice since, sitting
            # inside a copy mode whose border, pill and chip had long moved on.
            # Same reason the scrollbar is here: they are STYLES, so they will
            # not expand #{@copy_mode_color} and have to be generated to stay
            # in sync.
            #
            # Three levels, one hue: the selection you are building and the
            # match you are ON are fully lit slabs (ink on the accent), and the
            # other matches sit in the same sunk bed the scrollbar track uses,
            # lettered in the accent -- present, countable, not shouting.
            f'setw -g mode-style "bg={B},fg={I}"',
            f'set -g copy-mode-match-style         "bg={S},fg={B},bold"',
            f'set -g copy-mode-current-match-style "bg={B},fg={I},bold"',
        ],
    },
}

# ---- tab styles -------------------------------------------------------------
# How the window rail is DRAWN, independent of what colour it is drawn in.
# `tmux-chip <colour>` sets the hue and keeps the style; `tmux-chip <style>`
# switches the drawing and keeps the hue -- the same split `pill` has between
# its colours and its shapes.
#
# A style emits the ACTIVE chip and nothing else. The inactive labels and the
# separator belong to `tmux-color` -- they are its DIM and BRIGHT, generated in
# its own block, and the split is deliberate (chips = the two lit things, color
# = the unlit ones and the readings, bar = the frame around all of it). A style
# that wanted to repaint them would have to override those two
# lines and should read @bar_dim / @bar_bright rather than bake a hex, so the
# rail keeps tracking tmux-color.
#
# INACT is the inactive-label colour the tmux-chip preview draws around its
# chips. It used to be a baked hex "today's value of that pair" -- and it went
# stale the first time the rail was recoloured, so the picker sold a bar with a
# steel-blue rail that had not existed for weeks. It is read from the live
# tmux-color block now (see inactive_hex); this value is only the fallback for a
# config that has no such block yet.
INACT = "#415c63"

TAB_STYLES = {
    # The design as it stands: active is a lit slab, sheared both ends, with a
    # leading ">" echoing the window rail one level down.
    #
    "slab": [
        # Only the ACTIVE chip flickers: the session pill and the rail stay
        # put, or the whole bar glitches at once and the motion stops meaning
        # "you are here".
        f'set -g window-status-current-format "#[fg={LIT},bg=default]{SLANT_L}'
        f'#[fg={I},bg={LIT},bold] > #[fg={I},bg={LIT},bold]'
        f'#{{E:@window_icon}} #I:#W '
        f'#[fg={LIT},bg=default,nobold]{SLANT_R}#[default]"',
    ],
}

TAB_WHAT = {
    "slab": "lit slab, sheared both ends (the original)",
}

# `tmux-copymode-color <hex>` predates this mode and set ONLY the option, which
# is now one of three things the hex has to touch. Kept as an alias so muscle
# memory and the comments in tmux.conf that name it still work; it gains the
# palette names, previews and completion the rest of the family has.
MODE_ALIASES = {"tmux-copymode-color": "tmux-copy"}

MODE = os.path.basename(sys.argv[0])
MODE = MODE_ALIASES.get(MODE, MODE)
if MODE not in MODES:
    # A name nobody defined still has to do something, and the bar is the
    # least surprising thing for it to paint. This fallback is ALSO what made
    # `tmux-color` a silent duplicate of `tmux-bar` for weeks -- the name had
    # no MODES entry, fell through here, and painted the bar's block. Anything
    # that ought to be its own surface needs an entry above, not this.
    MODE = "tmux-bar"
M = MODES[MODE]
STATE = f"{STATE_DIR}/{MODE}-previous"


def die(msg):
    print(f"{MODE}: {msg}", file=sys.stderr)
    sys.exit(1)


def rgb(h):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def scale(h, k):
    r, g, b = rgb(h)
    return "#%02x%02x%02x" % (int(r * k), int(g * k), int(b * k))


def swatch(h, label="   "):
    r, g, b = rgb(h)
    ri, gi, bi = rgb(INK)
    return f"\033[48;2;{r};{g};{b}m\033[38;2;{ri};{gi};{bi}m{label}\033[0m"


def slab(bg_hex, fg_hex, label):
    br, bg, bb = rgb(bg_hex)
    fr, fg_, fb = rgb(fg_hex)
    return f"\033[48;2;{br};{bg};{bb}m\033[38;2;{fr};{fg_};{fb}m{label}\033[0m"


def fg(h):
    r, g, b = rgb(h)
    return f"\033[0m\033[38;2;{r};{g};{b}m"


def palette():
    """Every color these commands offer, read live from starship.toml:

        pill_*   shared with the prompt. `pill` owns this table.
        text_*   body foregrounds, owned by cc-fg/cc-fg-dim/cc-em. Included
                 here because tmux-pane, tmux-pane-lines and tmux-copy set
                 FOREGROUNDS and borders, where a quiet colour is a real
                 choice. On tmux-bar/tmux-chip they are slab FILLS carrying
                 ink text, and a dark one there is unreadable -- the preview
                 row shows exactly that, so judge it there before committing.
                 They stay out of `pill` entirely: the pill_* invariant is
                 black text >=4.5:1 plus brand logos >=2.0:1 after the CRT
                 dim, and every text_* colour fails it by design.
        tmux_*   tmux only -- too saturated to carry brand logos, so `pill`
                 must not see them. See the note by the table itself.

    Adding a line to either table is all it takes; nothing here is hardcoded.
    """
    if not os.path.isfile(STARSHIP):
        die(f"no starship config at {STARSHIP}")
    src = open(STARSHIP, encoding="utf-8").read()
    out = []
    for m in re.finditer(r"^(pill|tmux|text)_([a-z0-9_]+)\s*=\s*'(#[0-9a-fA-F]{6})'",
                         src, re.M):
        out.append((re.sub(r"_lifted$|_white$", "", m.group(2)), m.group(3)))
    if not out:
        die("no pill_* or tmux_* colors found in starship.toml")
    return out


def read_conf():
    if not os.path.isfile(TMUX_CONF):
        die(f"no tmux config at {TMUX_CONF}")
    return open(TMUX_CONF, encoding="utf-8").read()


def current(src):
    m = re.search(rf"^{re.escape(M['begin'])}.*?^# bright = (#[0-9a-fA-F]{{6}})",
                  src, re.M | re.S)
    return m.group(1) if m else None


def block_bright(mode):
    """The `bright =` recorded in ANOTHER mode's managed block, or None.

    Every block carries its colour in its header comment, which makes the file
    the one place a preview can ask "what is that other surface set to right
    now" without shelling out to a running tmux (there may not be one). Used so
    a picker row never draws a neighbouring surface from a baked hex.
    """
    m = MODES.get(mode)
    if not m:
        return None
    try:
        src = open(TMUX_CONF, encoding="utf-8").read()
    except OSError:
        return None
    hit = re.search(rf"^{re.escape(m['begin'])}.*?^# bright = (#[0-9a-fA-F]{{6}})",
                    src, re.M | re.S)
    return hit.group(1) if hit else None


def inactive_hex():
    """What an inactive window label is actually drawn in: tmux-color's DIM."""
    b = block_bright("tmux-color")
    return scale(b, DIM_SCALE) if b else INACT


def resolve(want, names):
    if want in names:
        return want
    hits = [n for n in names if n.startswith(want)] or [n for n in names if want in n]
    if not hits:
        return None
    if len(hits) > 1:
        die(f"'{want}' is ambiguous: {', '.join(hits)}")
    return hits[0]


def preview(bright):
    """A bar-shaped sample: lit slab, active label, divider, dim label."""
    dim = scale(bright, DIM_SCALE)
    if MODE == "tmux-chip":
        # Only the two chips are lit here; the bar around them stays neutral,
        # which is the whole point of the command. The active window chip is
        # drawn in the CURRENT tab style, so the picker sells the bar you get.
        sess = swatch(bright, " DEV ") + fg(bright) + SLANT_R + "  "
        return (sess + fg(bright) + SLANT_L + swatch(bright, " > 1:nvim ") +
                fg(bright) + SLANT_R + "  " +
                fg(inactive_hex()) + " 2:logs" + "\033[0m")
    if MODE == "tmux-pane-lines":
        # The split divider: lit half nearest the active pane, unlit rest.
        return (fg(bright) + "─────────" + fg(dim) + "──────────" + "\033[0m")
    if MODE == "tmux-copy":
        # All three things the hex lands on, in one row: the COPY chip, a
        # copy-tinted border, and the scrollbar drawn HORIZONTALLY (it is
        # vertical in the pane, but a row of cells is what a picker line has).
        # The thumb is the accent, the track around it the same hue sunk to
        # SUNK_SCALE -- so a colour whose trough goes muddy shows it here.
        sunk = scale(bright, SUNK_SCALE)
        return (fg(bright) + LCAP + swatch(bright, " COPY ") +
                fg(bright) + RCAP + " " +
                fg(bright) + "──" + " " +
                slab(sunk, sunk, "──") + slab(bright, bright, "────") +
                slab(sunk, sunk, "────") + "\033[0m")
    if MODE == "tmux-float":
        # The float's rounded frame against a pane divider, so the picker shows
        # the only comparison that matters: does it read as NOT a pane.
        return (fg(inactive_hex()) + "──────" +
                fg(bright) + "╭─ scratch ──╮" +
                fg(inactive_hex()) + "──────" + "\033[0m")
    if MODE == "tmux-pane":
        return (fg(dim) + "──" + fg(bright) + SLANT_L +
                swatch(bright, " 1 ") + fg(bright) +
                slab(ION_BODY, bright, SLANT_R + " zsh · repo ") +
                fg(ION_BODY) + SLANT_R +
                fg(dim) + "────" + "\033[0m")
    if MODE == "tmux-color":
        # The preview MUST wear the same shapes the templates emit, or the
        # picker sells a bar you will not get. The rail is the hairline slant,
        # the labels are dim, and status-right carries git + language versions
        # (rendered by the status-context helper, brand-coloured so they do NOT
        # track this colour) then the dim date and the filled clock chip. No
        # session or active chip here -- those are tmux-chip's, and drawing
        # them would sell a colour this command cannot set.
        return (fg(dim) + " 2:logs" +
                fg(bright) + " " + SLANT_THIN + " " + fg(dim) + "3:logs" +
                fg(bright) + "  " + fg("#f1502f") + " " + fg(dim) + "main" +
                fg("#00add8") + "  1.22" +
                fg(dim) + "  Sun 7/26 " + fg(bright) + LCAP +
                swatch(bright, "09:41") + fg(bright) + RCAP + "\033[0m")
    # tmux-bar: the frame. Row 1's rule with the HUD sitting right-aligned on
    # it, and a mode chip at the left -- the row's own shapes, none of the
    # window strip's. Whatever `tmux-color` and `tmux-chip` are set to is not
    # this command's business and is deliberately absent from the sample.
    return (fg(bright) + LCAP + swatch(bright, " ZOOMED ") + fg(bright) + RCAP +
            fg(bright) + " " + "═" * 8 +
            fg(dim) + " 2 panes · 4 win " + "\033[0m")


def current_style(src):
    """The tab style recorded in the managed block, for `tmux-chip <colour>` to
    preserve. Absent (a block written before styles existed) means `slab`, which
    is what that block was drawing."""
    m = re.search(rf"^{re.escape(M['begin'])}.*?^# tabstyle = ([a-z]+)",
                  src, re.M | re.S)
    return m.group(1) if m and m.group(1) in TAB_STYLES else "slab"


def build_block(bright, style="slab"):
    dim, sunk = scale(bright, DIM_SCALE), scale(bright, SUNK_SCALE)
    lines = M["lines"]
    out = [M["begin"] + f"  DO NOT EDIT BY HAND -- rewritten by `{MODE}`",
           f"# bright = {bright}   active / values / dividers",
           f"# dim    = {dim}   labels / inactive / unlit"]
    if MODE == "tmux-chip":
        # The style's lines come last so they override anything above them, and
        # the marker goes in the header so `tmux-chip <colour>` can read the
        # style back and keep it.
        lines = lines + TAB_STYLES[style]
        out.append(f"# tabstyle = {style}   {TAB_WHAT[style]}")
    for ln in lines:
        out.append(ln.replace(B, bright).replace(D, dim)
                     .replace(S, sunk).replace(I, INK)
                     .replace(NB, scale(bright, NUM_SCALE))
                     .replace(ND, scale(dim, NUM_SCALE))
)
    out.append(M["end"])
    return "\n".join(out)


def write(bright, label, style=None, style_switch=False):
    src = read_conf()
    if M["begin"] not in src or M["end"] not in src:
        die(f"{M['begin']} markers not found in {TMUX_CONF}; refusing to write")
    prev = current(src)
    # A colour change keeps whatever style is already recorded, and a style
    # change keeps the colour -- neither ever silently resets the other.
    style = style or current_style(src)

    head, rest = src.split(M["begin"], 1)
    _, tail = rest.split(M["end"], 1)
    new = head + build_block(bright, style) + tail

    # Guard: repainting must never LOSE a glyph. The pill caps ( )
    # and the session wedge () are invisible in a diff, so a template that
    # drops one turns a rounded pill into a bare slab with nothing to notice.
    # Gaining glyphs is allowed -- that is a template fix landing.
    def glyphs(s):
        return sum(1 for c in s if ord(c) > 0x2000)
    # The guard cannot tell a regression from an intentional removal, so removing
    # a glyph on purpose needs saying so out loud. Deliberately an env var and
    # not a flag: it should be awkward enough that it is never reached for by
    # habit, and it should not appear in the usage line as a normal option.
    # An explicit style switch is allowed to lose glyphs: a style is free to
    # have no shear caps at all. The guard still covers every colour change and
    # every template edit, which is what it was built for -- a cap vanishing
    # from a template nobody touched on purpose.
    if (glyphs(new) < glyphs(src) and not style_switch
            and not os.environ.get("TMUX_COLOR_ALLOW_GLYPH_DROP")):
        die(f"would drop {glyphs(src) - glyphs(new)} glyph(s) "
            "(pill caps? icons?); config left untouched. "
            "If the template genuinely dropped one on purpose, re-run with "
            "TMUX_COLOR_ALLOW_GLYPH_DROP=1")

    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(TMUX_CONF))
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(new)
    shutil.copymode(TMUX_CONF, tmp)
    shutil.move(tmp, TMUX_CONF)

    if prev:
        os.makedirs(STATE_DIR, exist_ok=True)
        open(STATE, "w").write(prev)

    live = ""
    if os.environ.get("TMUX"):
        r = subprocess.run(["tmux", "source-file", TMUX_CONF],
                           capture_output=True, text=True)
        live = "  -> live" if r.returncode == 0 else f"  -> reload failed: {r.stderr.strip()}"
        # A colour change (not a style-only switch) on tmux-chip has to win
        # over session-hue's auto-assignment, which re-runs on every session-
        # created event and every config reload and otherwise silently
        # overwrites the SESSION-scoped @session_hue the line above just wrote
        # globally -- tmux resolves the session-scoped option first, so the
        # global write above is invisible to any session session-hue has
        # already touched (which by the time you're running this, is all of
        # them). Pinning THIS session's option directly is what makes the
        # change actually visible; see PINNING in the module docstring.
        if MODE == "tmux-chip" and not style_switch:
            subprocess.run(["tmux", "set-option", "@session_hue", bright],
                           capture_output=True, text=True)
            subprocess.run(["tmux", "set-option", "@session_hue_pin", "1"],
                           capture_output=True, text=True)
            live += " (this session pinned)"
    else:
        live = "  -> next tmux start"
    print(f"  {M['what']}: {label}  {preview(bright)}{live}")


def main(arg):
    global TAB_STYLE
    src = read_conf()
    colors = palette()
    active = current(src)
    if MODE == "tmux-chip":
        TAB_STYLE = current_style(src)

    if arg is None:
        print()
        for name, hexv in colors:
            mark = " *" if active and hexv.lower() == active.lower() else "  "
            print(f"{mark} {name:<14} {preview(hexv)}  {hexv}")
        print()
        print(f"  * = active    usage: {MODE} <name>    ({MODE} - to go back)")
        if MODE == "tmux-chip":
            cur = current_style(src)
            marked = "  ".join((f"{n}*" if n == cur else n) for n in TAB_STYLES)
            print(f"  tab style:  {marked}")
            print(f"              {TAB_WHAT[cur]}")
            print(f"  a style keeps the colour, a colour keeps the style.")
            print(f"  a colour pins THIS session; `{MODE} auto` un-pins it.")
        if MODE == "tmux-copy":
            print(f"  one hex -> copy border + pill + COPY chip, scrollbar thumb,")
            print(f"  and scrollbar track at {int(SUNK_SCALE * 100)}% of it.")
        elif MODE == "tmux-color":
            # The one surface where the rail is DIM -- see the note by the
            # window-status-separator line. Saying so here stops the generic
            # "dividers take bright" from being read as a promise this command
            # does not keep.
            print(f"  bright = clock chip + news marks, dim = 48% of it:")
            print(f"  inactive labels, the rail, the date.")
        else:
            print(f"  bright = the color, dim = 48% of it; dividers take bright.")
        print()
        return

    if arg == "current":
        # The active hex, straight from the managed block's `bright =` marker.
        # Prints the palette name too when the hex matches a pocketed colour.
        if not active:
            die("no managed block yet -- run the command once to set a colour")
        name = next((n for n, h in colors if h.lower() == active.lower()), None)
        print(f"{active}  {name}" if name else active)
        return

    if arg == "auto" and MODE == "tmux-chip":
        # Release THIS session's pin and hand it back to session-hue. See
        # PINNING in the module docstring for why a pin exists at all.
        if not os.environ.get("TMUX"):
            die("not inside tmux -- nothing to unpin")
        subprocess.run(["tmux", "set-option", "-u", "@session_hue_pin"],
                       capture_output=True, text=True)
        subprocess.run(["tmux", "set-option", "-u", "@session_hue"],
                       capture_output=True, text=True)
        session_hue = f"{HOME}/.config/nvim/dotfiles/tmux/session-hue"
        subprocess.run([session_hue], capture_output=True, text=True)
        got = subprocess.run(["tmux", "show-options", "-qv", "@session_hue"],
                             capture_output=True, text=True).stdout.strip()
        print(f"  session chip: back to automatic  {preview(got)}" if got
              else "  session chip: back to automatic")
        return

    if arg == "__complete":
        # Candidate first-args, one per line, for shell completion. Reads names
        # live from starship.toml so a new pill_*/tmux_* line needs no extra step.
        styles = list(TAB_STYLES) if MODE == "tmux-chip" else []
        extra = ["auto"] if MODE == "tmux-chip" else []
        print("\n".join(["-", "current"] + extra + styles + [c[0] for c in colors]))
        return

    # A tab style, not a colour: keep the hue, change the drawing. Checked
    # BEFORE the colour table so a style name can never be swallowed by the
    # prefix matcher (nothing is named for a style today, but `resolve` matches
    # on substrings and a future pill_dock would collide silently).
    if MODE == "tmux-chip" and arg in TAB_STYLES:
        if not active:
            die("no managed block yet -- set a colour first")
        TAB_STYLE = arg          # so the confirmation line previews the NEW style
        write(active, f"{arg}  ({TAB_WHAT[arg]})", style=arg, style_switch=True)
        return

    if arg == "-":
        if not os.path.isfile(STATE):
            die("no previous recorded")
        write(open(STATE).read().strip(), "previous")
        return

    m = re.fullmatch(r"#?([0-9a-fA-F]{6})", arg)
    if m:
        hexv = "#" + m.group(1).lower()
        write(hexv, hexv)
        return

    name = resolve(arg, [c[0] for c in colors])
    if not name:
        die(f"no color matching '{arg}'   (run `{MODE}` for the list)")
    write(dict(colors)[name], name)


if __name__ == "__main__":
    main(sys.argv[1] if len(sys.argv) > 1 else None)
