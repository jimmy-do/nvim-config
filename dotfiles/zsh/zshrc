# ==========================================
# 1. Framework & Core Shell Core
# ==========================================
export ZSH="$HOME/.oh-my-zsh"

# Explicitly default the theme to prevent fallback cache corruption
ZSH_THEME=""

plugins=(
    git
    docker
    kubectl
)

source $ZSH/oh-my-zsh.sh

# ==========================================
# 2. Modern DevOps Aliases & Tooling
# ==========================================
# Kubernetes
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgpa='kubectl get pods -A'
alias kdp='kubectl describe pod'
alias kl='kubectl logs'
alias klp='kubectl logs --previous'
alias kctx='kubectl config current-context'

# Terraform
alias tf='terraform'
alias tfp='terraform plan'
alias tfa='terraform apply'

# Git
alias gs='git status'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'

# Utilities (Bat, Clear)
alias cat='bat --style=plain --paging=never'
alias c='clear'
alias nvim-k="NVIM_APPNAME=nvim-kickstart nvim"
alias nvim-l="NVIM_APPNAME=nvim-lazyvim nvim"

# ==========================================
# 3. eza Wrapper Engine (File Listing)
# ==========================================
unalias ls ll la lt ltt lttt l 2>/dev/null

unset NO_COLOR
export CLICOLOR=1

ls()   { command eza --icons --color=always "$@" }
ll()   { command eza --icons --color=always --long --git "$@" }
la()   { command eza --icons --color=always --long --all --git "$@" }
lt()   { command eza --icons --color=always --tree --level=2 --git --git-ignore "$@" }
ltt()  { command eza --icons --color=always --tree --level=3 --git --git-ignore "$@" }
lttt() { command eza --icons --color=always --tree --level=4 --git --git-ignore "$@" }
l()    { command eza --icons --color=always --grid "$@" }

compdef _files ls ll la lt ltt lttt l

# ==========================================
# 4. Custom Environment & Automation Functions
# ==========================================
export PATH="$HOME/.local/bin:$PATH"

ghosttythemes() {
  mkdir -p ~/.config/ghostty/themes
  local files=(~/Downloads/*-default(N) ~/Downloads/*-dark(N))
  if [ -e "${files[1]}" ]; then
    mv "${files[@]}" ~/.config/ghostty/themes/
    echo "Moved Ghostty themes."
  else
    echo "No *-default theme files found in Downloads."
  fi
}

# Search YouTube, pick a result with fzf, play it with mpv
yt() {
  local query="$*"
  local tab=$'\t'
  local results
  results=$(yt-dlp "ytsearch12:$query" \
    --flat-playlist \
    --print "%(duration_string)s  %(channel)s  ·  %(title)s${tab}%(id)s" 2>/dev/null)

  [ -z "$results" ] && { echo "No results."; return 1; }

  local pick
  pick=$(printf '%s\n' "$results" | fzf --with-nth=1 --delimiter="$tab" \
    --prompt="▶ pick a video: " --height=50% --reverse)

  [ -z "$pick" ] && return 0

  local id
  id=$(printf '%s' "$pick" | cut -d"$tab" -f2)
  nohup mpv --no-terminal --force-window=immediate \
    --macos-app-activation-policy=accessory \
    --ontop --ontop-level=system \
    --autofit=800x450 --geometry=100%:100% \
    --ytdl-format="bestvideo[height<=720]+bestaudio/best[height<=720]" \
    "https://www.youtube.com/watch?v=$id" >/dev/null 2>&1 &
  disown
}

bindkey '^U' backward-kill-line

# Minimal Antigravity and same-session YouTube helpers.
source ~/.config/nvim/dotfiles/zsh/terminal-tools.zsh

# Fuzzy Finder Initialization
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# --- Edit current shell command in Neovim on demand ---
export EDITOR="nvim"
export VISUAL="nvim"

autoload -Uz edit-command-line
zle -N edit-command-line

# Standard-ish fallback
bindkey '^X^E' edit-command-line

# Easier custom keybind
bindkey '^O' edit-command-line

# Retro startup banner — top-level interactive shells only (skips tmux panes,
# nested shells, and scripts).
if [[ $- == *i* && -z "$TMUX" ]] && (( SHLVL == 1 )); then
  source ~/.config/zsh/retro-banner.zsh
  retro_banner
fi

# Show one quote for each new interactive shell.
if [[ $- == *i* ]]; then
  ~/.local/bin/tmux-quote
fi

# Keep interactive command input light retro amber (#ffb454, matching the cursor)
# while command output returns to the terminal foreground color. ZLE hooks avoid
# recoloring program output.
autoload -Uz add-zle-hook-widget
_soft_orange_line_init() { printf "\e[38;2;255;180;84m" }
_soft_orange_line_finish() { printf "\e[0m" }
add-zle-hook-widget line-init _soft_orange_line_init
add-zle-hook-widget line-finish _soft_orange_line_finish

# ==========================================
# 6. Prompt Initialization (Starship Engine)
# ==========================================
if command -v starship &> /dev/null; then
    # Force kill any residual prompt variables before initializing
    unset PROMPT PROMPT2 RPROMPT RPROMPT2
    eval "$(starship init zsh)"
    # Swap prompt tiers by pane width. Must come AFTER init -- it reorders
    # itself ahead of starship's own precmd hook.
    source ~/.config/zsh/starship-responsive.zsh
    # Collapse finished prompts to a bare caret. AFTER init: it overrides the
    # accept-line widget, and starship's init must not re-bind it afterwards.
    source ~/.config/zsh/starship-transient.zsh
fi
eval "$(zoxide init zsh)"

# ncdu root disk scan for Ghostty/Homebrew ncurses
ncdur() {
  sudo env TERMINFO_DIRS="$HOME/.terminfo:/var/root/.terminfo:$(brew --prefix ncurses)/share/terminfo:/usr/share/terminfo" ncdu -x /
}
source <(kubectl completion zsh)
